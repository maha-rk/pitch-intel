# Pitch Intel — environment configuration
# Copy to backend/.env and fill in. Pick ONE provider (or leave LLM_PROVIDER=auto).

# Which inference backend to use: auto | watsonx | ollama | groq
# auto = watsonx if creds set, else Ollama if running, else Groq (NOT Granite).
LLM_PROVIDER=auto

# --- Primary: IBM watsonx.ai (real IBM Granite) -----------------------------
# Create a free key + project at https://dataplatform.cloud.ibm.com/
# A Space (WATSONX_SPACE_ID) is the most reliable target — it binds directly to
# your watsonx.ai Runtime. Set it OR a project id; space takes priority.
WATSONX_API_KEY=
WATSONX_SPACE_ID=
WATSONX_PROJECT_ID=
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
# Model availability varies by region. eu-de (Frankfurt): ibm/granite-4-h-small.
# us-south (Dallas) also offers ibm/granite-3-3-8b-instruct.
WATSONX_MODEL=ibm/granite-4-h-small

# --- Offline option: IBM Granite via Ollama ---------------------------------
# Install Ollama, then: ollama pull granite3.3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3:8b

# --- Legacy dev fallback: Groq (runs Llama, NOT Granite) --------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- LangFlow (optional — enables visual pipeline canvas for Debate Room) ---
# Install: pip install langflow
# Run:     langflow run --flow flows/pitch_debate_flow.json --port 7860
# Then set this URL so the debate endpoint routes through the LangFlow server.
# Leave blank to use the direct Granite implementation (same logic, same result).
LANGFLOW_URL=http://localhost:7860
